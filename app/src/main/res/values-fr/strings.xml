    <!-- Carte du service et information accessibilité -->
    <string name="service_off_title">Le service de blocage est désactivé</string>
    <string name="service_off_text">Active « LibreBlock » dans les réglages d\'accessibilité pour que le blocage fonctionne.</string>
    <string name="enable_blocking">Activer le blocage</string>
    <string name="restricted_hint">Option grisée ? (Android 13+) Va dans Infos de l\'appli → menu ⋮ → « Autoriser les paramètres restreints », puis réessaie.</string>
    <string name="app_info">Infos de l\'appli</string>
    <string name="disclosure_title">Utilisation de l\'accessibilité</string>
    <string name="disclosure_intro">LibreBlock utilise l\'API d\'accessibilité d\'Android (AccessibilityService) pour bloquer les applis que tu as choisies.</string>
    <string name="disclosure_does_title">Ce que LibreBlock fait avec cette autorisation :</string>
    <string name="disclosure_does_1">• détecter quelle appli est ouverte, pour afficher l\'écran de blocage si elle est bloquée ;</string>
    <string name="disclosure_does_2">• en mode strict uniquement, lire le texte des écrans Paramètres et de désinstallation pour refermer ceux qui permettraient de désactiver ou de désinstaller LibreBlock.</string>
    <string name="disclosure_doesnt_title">Ce que LibreBlock ne fait pas :</string>
    <string name="disclosure_doesnt">• aucune donnée n\'est collectée, enregistrée ni envoyée : l\'appli n\'a pas accès à Internet ;\n• le contenu des autres applis n\'est ni lu ni conservé.</string>
    <string name="disclosure_disable">Tu peux désactiver ce service à tout moment dans les réglages d\'accessibilité (hors mode strict).</string>
    <string name="accept">J\'accepte</string>
    <string name="decline">Refuser</string>
    <string name="privacy_title">Confidentialité</string>
    <string name="privacy_text">LibreBlock n\'a pas accès à Internet et ne collecte aucune donnée. Tes réglages restent sur ce téléphone.</string>

