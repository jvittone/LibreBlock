    <!-- Accessibility service card and disclosure -->
    <string name="service_off_title">The blocking service is off</string>
    <string name="service_off_text">Turn on “LibreBlock” in the accessibility settings for blocking to work.</string>
    <string name="enable_blocking">Enable blocking</string>
    <string name="restricted_hint">Option greyed out? (Android 13+) Go to App info → ⋮ menu → “Allow restricted settings”, then try again.</string>
    <string name="app_info">App info</string>
    <string name="disclosure_title">Use of accessibility</string>
    <string name="disclosure_intro">LibreBlock uses the Android accessibility API (AccessibilityService) to block the apps you have chosen.</string>
    <string name="disclosure_does_title">What LibreBlock does with this permission:</string>
    <string name="disclosure_does_1">• detect which app is open, to show the block screen if it is blocked;</string>
    <string name="disclosure_does_2">• in strict mode only, read the text of Settings and uninstall screens to close those that would disable or uninstall LibreBlock.</string>
    <string name="disclosure_doesnt_title">What LibreBlock does not do:</string>
    <string name="disclosure_doesnt">• no data is collected, stored or sent: the app has no Internet access;\n• the content of other apps is neither read nor kept.</string>
    <string name="disclosure_disable">You can turn this service off at any time in the accessibility settings (except in strict mode).</string>
    <string name="accept">I agree</string>
    <string name="decline">Decline</string>
    <string name="privacy_title">Privacy</string>
    <string name="privacy_text">LibreBlock has no Internet access and collects no data. Your settings stay on this phone.</string>

